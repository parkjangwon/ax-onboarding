{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrganizationAddon",
  "description": "Enterprise and organizational addon for injecting ground-rules, private tools, and workflows",
  "type": "object",
  "required": ["addonId", "name", "organization", "version", "groundRules"],
  "properties": {
    "addonId": { "type": "string" },
    "name": { "type": "string" },
    "organization": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "targetArchetypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "groundRules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "securityGuidelines": {
      "type": "array",
      "items": { "type": "string" }
    },
    "vcs": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["gitlab", "github", "gitea", "bitbucket", "other"] },
        "baseUrl": { "type": "string" },
        "guidelinesRepo": { "type": "string" },
        "workflowPhases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mcpCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["stdio", "http", "sse"] },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string" },
          "env": { "type": "object" },
          "safetyLevel": { "type": "string", "enum": ["safe", "readonly", "requires_approval", "sensitive"] },
          "notes": { "type": "string" }
        }
      }
    },
    "recommendedPlugins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "customQuestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
